<UserControl x:Class="plugin_OpenVR.Pages.SettingsPage" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:pluginOpenVr="using:plugin_OpenVR"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:utils="clr-namespace:plugin_OpenVR.Utils"
             Loaded="SettingsPage_OnLoaded" x:Name="Root" Margin="0,-8,0,0">
    <Grid HorizontalAlignment="Stretch" RowDefinitions="Auto, Auto" ColumnSpacing="12">
        <Grid Grid.Row="0" Margin="0,0,0,8" ColumnDefinitions="Auto,*" ColumnSpacing="5">
            <ToggleSwitch Grid.Column="0" Margin="3,0,0,0" FontWeight="SemiBold" FontSize="15"
                          x:Name="StandableToggleSwitch"
                          OnContent="{utils:Translate '/Settings/Toggles/Standable'}"
                          OffContent="{utils:Translate '/Settings/Toggles/Standable'}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          IsChecked="{Binding #Root.IsStandableSupportEnabled, Mode=TwoWay}"
                          VerticalContentAlignment="Center" />
            <TextBlock Grid.Column="1" FontSize="15" FontWeight="SemiBold" Opacity="0.6"
                       Text="{utils:Translate '/Settings/Toggles/Standable/Comment'}"
                       VerticalAlignment="Center" Margin="0,0,0,-3" />
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12" HorizontalAlignment="Stretch">
            <Button Grid.Column="0" Height="40" FontWeight="SemiBold" FontSize="16"
                    Content="{utils:Translate '/InputActions/Buttons/View'}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                <Button.Flyout>
                    <Flyout Placement="Center" Opening="ActionsFlyout_OnOpening" Closing="ActionsFlyout_OnClosing">
                        <Flyout.FlyoutPresenterTheme>
                            <ControlTheme TargetType="FlyoutPresenter">
                                <Setter Property="MaxHeight" Value="500" />
                                <Setter Property="MaxWidth" Value="820" />
                                <Setter Property="MinWidth" Value="820" />
                                <Setter Property="Margin" Value="30,15,0,0" />
                                <Setter Property="CornerRadius" Value="8" />
                                <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorTertiaryBrush}" />
                            </ControlTheme>
                        </Flyout.FlyoutPresenterTheme>
                        <!--Outer grid-->
                        <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch" MaxWidth="790" MinWidth="790"
                              MaxHeight="475" MinHeight="475">
                            <!--Inner grid-->
                            <Grid VerticalAlignment="Stretch" MaxWidth="790" MinWidth="790" MaxHeight="475"
                                  MinHeight="475" ColumnDefinitions="170,40,*" x:Name="OuterGrid">
                                <!--The selector part-->
                                <Grid Grid.Column="0" RowDefinitions="*,Auto" Margin="-20">
                                    <ScrollViewer HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                  VerticalScrollBarVisibility="Visible" Grid.Row="0"
                                                  Padding="20,0, 13, 0" Margin="-20,0, -15, 0">
                                        <ListBox x:Name="ActionsListView"
                                                 SelectionChanged="ActionsListView_OnSelectionChanged"
                                                 ItemsSource="{Binding #Root.CustomActions, Mode=OneWay}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="pluginOpenVr:InputAction">
                                                    <TextBlock Text="{Binding NameLocalized}" />
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </ScrollViewer>
                                    <StackPanel Orientation="Vertical" Grid.Row="1">
                                        <controls:MenuFlyoutItem
                                            Text="{utils:Translate '/InputActions/Picker/Options/New'}"
                                            Click="NewActionItem_OnClick" />
                                    </StackPanel>
                                </Grid>
                                <!--The preview part-->
                                <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*" Margin="-8,0,0,-2"
                                      x:Name="PreviewGrid">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding #Root.SelectedActionName, Mode=OneWay}"
                                               IsVisible="{Binding #Root.IsAddingNewActionInverse, Mode=OneWay}"
                                               VerticalAlignment="Top" HorizontalAlignment="Left" MaxWidth="370"
                                               FontSize="26" Margin="0,-7,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBox FontWeight="SemiBold"
                                             Text="{Binding #Root.SelectedActionName, Mode=TwoWay}"
                                             IsVisible="{Binding #Root.IsAddingNewAction, Mode=OneWay}" Grid.Row="0"
                                             Watermark="{utils:Translate '/SettingsPage/Placeholders/NewAction'}"
                                             VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="20"
                                             Margin="0,-5,0,5" Background="Transparent" MaxWidth="370" MinWidth="370"
                                             AcceptsReturn="False" TextWrapping="NoWrap" />
                                    <SplitButton Click="ActionTestButton_OnClick" x:Name="ActionRemoveSplitButton"
                                                 IsEnabled="{Binding #Root.ActionValid, Mode=OneWay}"
                                                 IsVisible="{Binding #Root.IsAddingNewActionInverse, Mode=OneWay}"
                                                 Content="{utils:Translate '/InputActions/Buttons/Test'}"
                                                 HorizontalAlignment="Right" VerticalAlignment="Top" Grid.Row="0"
                                                 Margin="0,-2,0,0">
                                        <SplitButton.Flyout>
                                            <Flyout Placement="Bottom">
                                                <Button Click="RemoveAction_OnClick"
                                                        IsEnabled="{Binding #Root.ActionValid, Mode=OneWay}"
                                                        Content="{utils:Translate '/InputActions/Buttons/Remove'}" />
                                            </Flyout>
                                        </SplitButton.Flyout>
                                    </SplitButton>
                                    <Button Classes="accent" Click="AddNewAction_OnClick"
                                            IsEnabled="{Binding #Root.ActionValid, Mode=OneWay}"
                                            IsVisible="{Binding #Root.IsAddingNewAction, Mode=OneWay}"
                                            Content="{utils:Translate '/InputActions/Buttons/Add'}"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Grid.Row="0"
                                            Margin="0,-2,0,0" />
                                    <!--"Select to preview" grid-->
                                    <Grid Grid.Row="2" Opacity="0.75"
                                          IsVisible="{Binding #Root.SelectedActionInvalid, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8*" MinWidth="250" MaxWidth="500" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center"
                                                    HorizontalAlignment="Center" Margin="0,-35,0,0">
                                            <controls:FontIcon FontSize="120" Margin="0,0,0,25" Glyph="&#xE707;" />
                                            <TextBlock HorizontalAlignment="Center" TextWrapping="Wrap" FontSize="14"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{utils:Translate '/InputActions/Picker/NoSelection'}" />
                                        </StackPanel>
                                    </Grid>
                                    <!--Actual preview data-->
                                    <Grid Grid.Row="2" RowDefinitions="Auto, *, Auto" RowSpacing="12"
                                          IsVisible="{Binding #Root.SelectedActionValid, Mode=OneWay}">
                                        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" FontSize="14"
                                                   Grid.Row="0" TextAlignment="Left" Margin="2,0,0,0"
                                                   Text="{Binding #Root.SelectedActionDescription, Mode=OneWay}"
                                                   Opacity="0.75" />
                                        <TextBox Grid.Row="1" Text="{Binding #Root.SelectedActionCode, Mode=TwoWay}"
                                                 VerticalAlignment="Stretch" AcceptsReturn="True" TextWrapping="Wrap"
                                                 Watermark="{utils:Translate '/InputActions/Code/Input'}" />
                                        <TextBox Grid.Row="2" x:Name="TestResultsBox" IsReadOnly="True"
                                                 IsEnabled="{Binding #Root.IsAddingNewActionInverse, Mode=OneWay}"
                                                 Text="{utils:Translate '/InputActions/Code/Test'}" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <SplitButton Grid.Column="1" x:Name="ReRegisterButton" Height="40" HorizontalAlignment="Stretch"
                         HorizontalContentAlignment="Stretch" Margin="0,0,12,0" Click="ReRegisterButton_OnClick">
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                    <TextBlock TextTrimming="CharacterEllipsis" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="{utils:Translate '/SettingsPage/Buttons/ReRegister'}" />
                    <ProgressBar x:Name="ReRegisterButtonBar" IsIndeterminate="True" Opacity="0.0"
                                 Margin="-11,0,-11,-9" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                        <ProgressBar.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CircularEaseInOut" />
                            </Transitions>
                        </ProgressBar.Transitions>
                    </ProgressBar>
                </Grid>
                <SplitButton.Flyout>
                    <Flyout Placement="Bottom">
                        <Button x:Name="ReManifestButton" Height="40" HorizontalAlignment="Stretch"
                                Click="ReManifestButton_OnClick">
                            <TextBlock TextTrimming="CharacterEllipsis" FontSize="16" FontWeight="SemiBold"
                                       Text="{utils:Translate '/SettingsPage/Buttons/ReManifest'}" />
                            <Button.Resources>
                                <!-- ReSharper disable once Xaml.RedundantResource -->
                                <Flyout x:Key="ActionFailedFlyout" Placement="Bottom"
                                        Opening="ActionFailedFlyout_OnOpening" Closing="ActionFailedFlyout_OnClosing" />
                            </Button.Resources>
                        </Button>
                    </Flyout>
                </SplitButton.Flyout>
            </SplitButton>
        </Grid>
    </Grid>
</UserControl>
